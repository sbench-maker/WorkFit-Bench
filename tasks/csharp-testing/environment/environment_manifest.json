        "agent",
        "verifier"
      ]
    },
    {
      "command": "python3",
      "version": "3.11.2",
      "used_by": [
        "verifier"
      ]
    },
    {
      "command": "dotnet",
      "version": "8.0.419",
      "used_by": [
        "agent",
        "verifier"
      ]
    }
  ],
