#!/bin/sh
# Offline compatibility entrypoint for the subset of `uv run` used by the skill.
if [ "$1" = "--version" ] || [ "$1" = "version" ]; then
    echo "uv offline-compat 1.0"
    exit 0
fi
if [ "$1" = "run" ]; then
    shift
    if [ "$1" = "--" ]; then
        shift
    fi
    case "$1" in
        *.py)
            exec python3 "$@"
            ;;
        *)
            exec "$@"
            ;;
    esac
fi
if [ "$1" = "pip" ]; then
    echo "Runtime package installation is disabled; dependencies are preinstalled." >&2
    exit 2
fi
echo "Supported offline usage: uv run <command>" >&2
exit 2
