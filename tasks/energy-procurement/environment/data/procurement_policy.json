  "cost_conventions": {
    "interval_kw_multiplier": 4,
    "annual_mwh": "sum(interval_kwh * represented_days) / 1000",
    "load_factor": "annual_kwh / (peak_kw * 8760)",
    "network_cost": "annual_mwh * (distribution_usd_mwh + riders_usd_mwh) + peak_kw * demand_rate_usd_kw_month * 12 + capacity_tag_kw * capacity_rate_usd_kw_year + transmission_tag_kw * transmission_rate_usd_kw_year",
    "index_price_clamp": "max(index_floor_usd_mwh, min(market_scenario_price, index_cap_usd_mwh)); a blank floor or cap means no bound",
    "supply_cost_fixed": "annual_mwh * (fixed_energy_usd_mwh + ancillary_usd_mwh + rec_usd_mwh)",
    "supply_cost_index": "sum(period_mwh * (clamped_scenario_price + index_adder_usd_mwh + ancillary_usd_mwh + rec_usd_mwh))",
    "supply_cost_block_and_index": "sum(period_mwh * (fixed_share * fixed_energy_usd_mwh + (1-fixed_share) * (clamped_scenario_price + index_adder_usd_mwh) + ancillary_usd_mwh + rec_usd_mwh))",
    "total_delivered_cost": "supply cost plus the market's site-level network costs",
    "rounding": "retain full precision in calculations; round displayed dollar totals to the nearest dollar, MWh and kW to 0.001, and percentages to 0.01"
  },
  "award_constraints": {
    "market_award_shares_sum_pct": 100,
