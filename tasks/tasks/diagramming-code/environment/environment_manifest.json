{
  "schema_version": "1.0",
  "network_mode": "no-network",
  "agent_user": "agent",
  "required_commands": [
    "bash",
    "python3",
    "trailmark",
    "uv"
  ],
  "required_python_packages": [
    {
      "distribution": "trailmark",
      "import_name": "trailmark",
      "version": "0.2.0",
      "used_by": [
        "agent"
      ]
    },
    {
      "distribution": "pytest",
      "import_name": "pytest",
      "version": "8.4.1",
      "used_by": [
        "verifier"
      ]
    }
  ],
  "agent_readable_paths": [
    "/root/data"
  ],
  "agent_writable_paths": [
    "/root/results"
  ]
}
