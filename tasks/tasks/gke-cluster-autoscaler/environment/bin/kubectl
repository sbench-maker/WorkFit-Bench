#!/usr/bin/env python3
"""Read-only kubectl-shaped adapter for the frozen task snapshot."""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path


DATA = Path(os.environ.get("TASK_DATA_DIR", "/root/data"))
VERSION = "kubectl-snapshot-adapter v1.0.0"


def load(name: str) -> dict:
    return json.loads((DATA / name).read_text(encoding="utf-8"))


def namespace_filter(payload: dict, namespace: str | None) -> dict:
    if not namespace:
        return payload
    result = dict(payload)
    result["items"] = [item for item in payload.get("items", []) if item.get("metadata", {}).get("namespace") == namespace]
    return result


def main(argv: list[str]) -> int:
    if argv[:1] == ["version"]:
        print(VERSION)
        return 0
    if argv[:2] == ["config", "current-context"]:
        print("gke_cobalt-retail-ops_us-central1_atlas-prod")
        return 0
    if not argv or argv[0] != "get":
        print("snapshot adapter is read-only; only get, version, and config current-context are supported", file=sys.stderr)
        return 2

    namespace = None
    if "-n" in argv:
        try:
            namespace = argv[argv.index("-n") + 1]
        except IndexError:
            print("-n requires a namespace", file=sys.stderr)
            return 2

    resource = argv[1] if len(argv) > 1 else ""
    if resource in {"pods", "pod"}:
        payload = namespace_filter(load("pods.json"), namespace)
    elif resource in {"pdb", "pdbs", "poddisruptionbudgets"}:
        payload = namespace_filter(load("pdbs.json"), namespace)
    elif resource in {"nodes", "node"}:
        payload = load("nodes.json")
    elif resource in {"configmap", "configmaps"} and "cluster-autoscaler-status" in argv:
        status = (DATA / "autoscaler_status.txt").read_text(encoding="utf-8")
        if any(arg.startswith("-o=jsonpath") or arg == "jsonpath={.data.status}" for arg in argv):
            print(status, end="")
            return 0
        payload = {
            "apiVersion": "v1",
            "kind": "ConfigMap",
            "metadata": {"name": "cluster-autoscaler-status", "namespace": "kube-system"},
            "data": {"status": status},
        }
    else:
        print(f"unsupported frozen resource: {resource}", file=sys.stderr)
        return 2

    print(json.dumps(payload, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
