{
  "schema_version": "1.0",
  "network_mode": "no-network",
  "agent_user": "agent",
  "required_commands": [
    "bash",
    "python3",
    "pytest",
    "jq",
    "awk",
    "cat",
    "cp",
    "grep",
    "mkdir",
    "rm",
    "sort",
    "uniq",
    "column",
    "kubectl"
  ],
  "required_command_versions": [
    {
      "command": "bash",
      "version": "GNU bash 5.2.15"
    },
    {
      "command": "python3",
      "version": "3.12.11"
    },
    {
      "command": "pytest",
      "version": "8.4.1"
    },
    {
      "command": "jq",
      "version": "jq-1.6"
    },
    {
      "command": "awk",
      "version": "mawk 1.3.4-20200120"
    },
    {
      "command": "cat",
      "version": "GNU coreutils 9.1"
    },
    {
      "command": "cp",
      "version": "GNU coreutils 9.1"
    },
    {
      "command": "grep",
      "version": "GNU grep 3.8"
    },
    {
      "command": "mkdir",
      "version": "GNU coreutils 9.1"
    },
    {
      "command": "rm",
      "version": "GNU coreutils 9.1"
    },
    {
      "command": "sort",
      "version": "GNU coreutils 9.1"
    },
    {
      "command": "uniq",
      "version": "GNU coreutils 9.1"
    },
    {
      "command": "column",
      "version": "util-linux 2.38.1"
    },
    {
      "command": "kubectl",
      "version": "kubectl-snapshot-adapter v1.0.0"
    }
  ],
  "required_python_packages": [
    {
      "distribution": "pytest",
      "import_name": "pytest",
      "version": "8.4.1",
      "used_by": [
        "verifier"
      ]
    },
    {
      "distribution": "iniconfig",
      "import_name": "iniconfig",
      "version": "2.1.0",
      "used_by": [
        "verifier"
      ]
    },
    {
      "distribution": "packaging",
      "import_name": "packaging",
      "version": "25.0",
      "used_by": [
        "verifier"
      ]
    },
    {
      "distribution": "pluggy",
      "import_name": "pluggy",
      "version": "1.6.0",
      "used_by": [
        "verifier"
      ]
    },
    {
      "distribution": "Pygments",
      "import_name": "pygments",
      "version": "2.19.2",
      "used_by": [
        "verifier"
      ]
    }
  ],
  "agent_readable_paths": [
    "/root/data"
  ],
  "agent_writable_paths": [
    "/root/results"
  ]
}
