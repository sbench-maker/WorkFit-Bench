{
  "schema_version": "1.0",
  "network_mode": "no-network",
  "agent_user": "agent",
  "required_commands": [
    "bash",
    "git",
    "python3"
  ],
  "required_python_packages": [
    {
      "distribution": "pytest",
      "import_name": "pytest",
      "version": "8.4.1",
      "used_by": [
        "agent",
        "verifier"
      ]
    },
    {
      "distribution": "pytest-cov",
      "import_name": "pytest_cov",
      "version": "6.2.1",
      "used_by": [
        "agent",
        "verifier"
      ]
    },
    {
      "distribution": "coverage",
      "import_name": "coverage",
      "version": "7.9.1",
      "used_by": [
        "agent",
        "verifier"
      ]
    }
  ],
  "agent_readable_paths": [
    "/root/data"
  ],
  "agent_writable_paths": [
    "/root/results"
  ]
}
