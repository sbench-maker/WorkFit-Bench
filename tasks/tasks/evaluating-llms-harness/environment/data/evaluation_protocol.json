{
  "aggregation": {
    "center": "arithmetic mean of compatible completed seed scores",
    "uncertainty": "sample standard deviation (ddof=1) and 95% CI half-width = 1.96 * sample_sd / sqrt(n)"
  },
  "release_policy": {
    "maximum_regression_vs_previous_release": 0.01,
    "minimum_macro_advantage_vs_external_baseline": 0.005,
