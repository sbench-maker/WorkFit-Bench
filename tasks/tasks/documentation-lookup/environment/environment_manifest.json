{
  "schema_version": "1.0",
  "network_mode": "no-network",
  "agent_user": "agent",
  "required_commands": [
    "bash",
    "python3",
    "context7-mock"
  ],
  "required_command_versions": [
    {
      "command": "bash",
      "version": "5.2.15(1)-release"
    },
    {
      "command": "python3",
      "version": "3.12.11"
    },
    {
      "command": "context7-mock",
      "version": "1.0.0"
    }
  ],
  "required_python_packages": [
    {
      "distribution": "pytest",
      "import_name": "pytest",
      "version": "8.4.1",
      "used_by": [
        "verifier"
      ]
    },
    {
      "distribution": "iniconfig",
      "import_name": "iniconfig",
      "version": "2.1.0",
      "used_by": [
        "verifier"
      ]
    },
    {
      "distribution": "packaging",
      "import_name": "packaging",
      "version": "25.0",
      "used_by": [
        "verifier"
      ]
    },
    {
      "distribution": "pluggy",
      "import_name": "pluggy",
      "version": "1.6.0",
      "used_by": [
        "verifier"
      ]
    },
    {
      "distribution": "Pygments",
      "import_name": "pygments",
      "version": "2.19.2",
      "used_by": [
        "verifier"
      ]
    }
  ],
  "agent_readable_paths": [
    "/root/data"
  ],
  "agent_writable_paths": [
    "/root/results"
  ]
}
