import("//build/config/chromeos/ui_mode.gni")

source_set("side_panel_core") {
  sources = [
    "//browser/side_panel_service.cc",
    "//browser/web_contents.cc",
    "//chromeos/app_window.cc",
    "//chromeos/multi_user_window_manager.cc",
    "//ui/side_panel_coordinator.cc",
  ]
}

source_set("side_panel_unittests") {
  testonly = true
  sources = [
    "//tests/unit/side_panel_service_unittest.cc",
    "//tests/unit/side_panel_coordinator_unittest.cc",
    "//tests/unit/url_formatter_unittest.cc",
  ]
  deps = [
    ":side_panel_core",
    "//testing/gtest",
  ]
}

source_set("side_panel_browser_tests") {
  testonly = true
  sources = [ "//tests/browser/existing_download_browsertest.cc" ]
  deps = [
    ":side_panel_core",
    "//testing/browser_test_support",
  ]

  if (is_chromeos) {
    sources += [ "//tests/browser/existing_app_window_browsertest.cc" ]
    deps += [ "//chromeos:test_support" ]
  }
}
