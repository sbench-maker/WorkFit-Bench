#!/usr/bin/env python3
"""Small offline stand-in for the Codex CLI review surface."""

from __future__ import annotations

import json
from pathlib import Path
import sys

from mock_review_lib import codex_response


def main() -> int:
    if "--version" in sys.argv:
        print("codex-cli 0.1.0-offline-fixture")
        return 0
    prompt = sys.stdin.read()
    output_path = None
    for index, argument in enumerate(sys.argv[:-1]):
        if argument in {"-o", "--output-last-message"}:
            output_path = Path(sys.argv[index + 1])
            break
    payload = json.dumps(codex_response(prompt), indent=2) + "\n"
    if output_path is not None:
        output_path.write_text(payload, encoding="utf-8")
    else:
        sys.stdout.write(payload)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
