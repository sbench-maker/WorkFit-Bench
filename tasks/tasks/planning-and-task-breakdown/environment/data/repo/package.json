{
  "name": "orbitdesk",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {"node": "22.14.0"},
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:api": "pnpm --filter @orbitdesk/api test",
    "test:worker": "pnpm --filter @orbitdesk/worker test",
    "test:web": "pnpm --filter @orbitdesk/web test"
  }
}
