{
  "schema_version": "1.0",
  "network_mode": "no-network",
  "agent_user": "agent",
  "required_commands": [
    "bash",
    "python3"
  ],
  "required_python_packages": [
    {
      "distribution": "numpy",
      "import_name": "numpy",
      "version": "2.2.6",
      "used_by": [
        "agent",
        "verifier"
      ]
    },
    {
      "distribution": "pandas",
      "import_name": "pandas",
      "version": "2.2.3",
      "used_by": [
        "agent",
        "verifier"
      ]
    },
    {
      "distribution": "pytest",
      "import_name": "pytest",
      "version": "8.4.1",
      "used_by": [
        "verifier"
      ]
    }
  ],
  "agent_readable_paths": [
    "/root/data"
  ],
  "agent_writable_paths": [
    "/root/results"
  ]
}
